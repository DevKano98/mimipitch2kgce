# ============================================================
# Copy this file to `.env` (same folder) and fill in the keys.
# This is the ONLY file you need to edit.
# ============================================================

# --- Required --------------------------------------------------
GROQ_API_KEY=
SARVAM_API_KEY=

# --- Models (change here, never in code) -----------------------
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave empty unless the vision model needs it (e.g. hidden / parsed)
GROQ_REASONING_FORMAT=

# --- Speech (Sarvam) -------------------------------------------
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN

# --- Storage ----------------------------------------------------
# local = SQLite + files on disk (no setup). supabase = optional later.
STORAGE_BACKEND=local
LOCAL_USER_ID=local-user
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=project-assets

# --- App --------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ENABLE_SAFETY=true
ENABLE_SOLVE_STAGE=true
DAILY_AI_CALL_CAP=300
